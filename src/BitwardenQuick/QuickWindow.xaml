<Window x:Class="BitwardenQuick.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BitwardenQuick"
        Title="BitwardenQuick" Width="660" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource SurfaceBrush}">
        <StackPanel>
            <Border Margin="12,12,12,8" CornerRadius="8" Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                <Grid Height="42" Margin="12,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Search Bitwarden" FontSize="17"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="17" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                             VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                             SelectionBrush="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="SyncIcon" Grid.Column="2" Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                               FontSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Syncing…" />
                </Grid>
            </Border>

            <ListBox x:Name="Results" MaxHeight="430" Margin="8,0,8,8" BorderThickness="0" Background="Transparent"
                     Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="OnResultDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="6" Padding="10,7" Margin="0,1" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ResultItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="7" Background="{Binding Avatar}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SubtitleVisibility}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12" Opacity="0.75"
                                           VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding RepromptVisibility}"
                                           ToolTip="Requires confirmation" />
                                <Border CornerRadius="4" Padding="6,1" BorderThickness="1" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Opacity="0.6" Visibility="{Binding OrganizationVisibility}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Organization}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Margin="24,6,24,18" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Border Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0" Padding="14,9">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Enter" /></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Password" />
                        <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl" /></Border>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="C" /></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Username" />
                        <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl" /></Border>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Shift" /></Border>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="U" /></Border>
                        <TextBlock Style="{StaticResource HintText}" Text="Website" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
