<Window x:Class="BwQuick.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="22">
        <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextBrush}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Master password" />
        <PasswordBox x:Name="Password" Style="{StaticResource Field}" />
        <TextBlock x:Name="Error" Margin="0,8,0,0" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed" Text="Incorrect master password." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="Confirm" Content="Confirm" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
