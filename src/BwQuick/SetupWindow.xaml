<Window x:Class="BwQuick.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BwQuick instellen" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="28,24,28,26">
        <TextBlock Text="Koppel je Bitwarden-kluis" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <TextBlock x:Name="Intro" Margin="0,8,0,4" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}">
            Je persoonlijke API-key vind je op vault.bitwarden.com onder
            <Run FontWeight="SemiBold">Instellingen › Beveiliging › Sleutels › API-sleutel bekijken</Run>.
            Je hoofdwachtwoord wordt alleen nu gebruikt om je kluissleutel te berekenen en wordt nergens opgeslagen.
        </TextBlock>

        <TextBlock Style="{StaticResource FieldLabel}" Text="client_id" />
        <TextBox x:Name="ClientId" Style="{StaticResource Field}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="client_secret" />
        <PasswordBox x:Name="ClientSecret" Style="{StaticResource Field}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Hoofdwachtwoord" />
        <PasswordBox x:Name="MasterPassword" Style="{StaticResource Field}" />

        <CheckBox x:Name="Autostart" Margin="0,16,0,0" IsChecked="True" Foreground="{DynamicResource TextBrush}"
                  Content="Starten met Windows" FontSize="13" />

        <TextBlock x:Name="Status" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}" />

        <Button x:Name="Connect" Margin="0,16,0,0" HorizontalAlignment="Right" Content="Verbinden"
                Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConnect" />
    </StackPanel>
</Window>
